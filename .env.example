# MH SCOUT Environment Variables Template
# Copy this file to .env and configure values

# Database - Neon PostgreSQL
# Pooled connection string for regular queries
DATABASE_URL="postgresql://username:password@ep-sample-pooler.ap-southeast-1.aws.neon.tech/pramukaone?sslmode=require"
# Direct connection string for Prisma migrations
DIRECT_URL="postgresql://username:password@ep-sample.ap-southeast-1.aws.neon.tech/pramukaone?sslmode=require"

# Authentication Session Secret (Generate with: openssl rand -base64 32)
AUTH_SECRET="your-super-secret-random-key-at-least-32-characters-long"

# Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Image Storage Provider
# Options: 'local' (saves to public/uploads) or 'cloudinary' or 's3'
IMAGE_STORAGE_PROVIDER="local"

# If using Cloudinary:
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""

# If using S3 / Supabase / Cloudflare R2:
# S3_ENDPOINT=""
# S3_REGION="auto"
# S3_BUCKET=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
